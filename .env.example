# =====================================================
# Universal Liquidity Manager — environment template
# Copy to `.env.local` and fill in the values.
# =====================================================

# WalletConnect Cloud project id (required for RainbowKit / WalletConnect).
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: dedicated RPC endpoints. If omitted, public fallbacks are used.
# Using your own RPC (Alchemy / Infura / etc.) is strongly recommended.
NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_8453=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_10=
NEXT_PUBLIC_RPC_URL_137=
NEXT_PUBLIC_RPC_URL_56=

# Optional: default chain id the app boots into (defaults to 1 = Ethereum mainnet).
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# =====================================================
# Solana
# =====================================================

# Solana mainnet RPC. Strongly recommended: the public endpoint
# (api.mainnet-beta.solana.com) is heavily rate-limited and rejects some of the
# account scans the Raydium / Orca / Meteora SDKs perform, so pool discovery and
# position loading will be unreliable without a dedicated endpoint.
# Helius, Triton, QuickNode and Alchemy all offer free tiers.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Optional: websocket endpoint. Derived from the wallet adapter's default when
# omitted; set it if your provider uses a separate WS host.
NEXT_PUBLIC_SOLANA_WS_URL=

# Optional: which ecosystem the app boots into — "evm" or "solana".
NEXT_PUBLIC_DEFAULT_ECOSYSTEM=evm

# Optional: which Solana venue is pre-selected. One of:
#   raydium-cpmm | raydium-clmm | orca-whirlpool | meteora-dlmm | meteora-damm
NEXT_PUBLIC_DEFAULT_SOLANA_PLATFORM=raydium-cpmm
